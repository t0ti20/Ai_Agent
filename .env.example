# Copy to .env for local development. .env is git-ignored and loaded automatically.
AGENT_ENV=dev

# Claude (profiles: smart, fast). Alternatively run `ant auth login`.
ANTHROPIC_API_KEY=

# OpenAI (profile: openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5

# Local OpenAI-compatible server (profile: local), e.g. Ollama
OLLAMA_URL=http://localhost:11434/v1
LOCAL_MODEL=qwen3:14b
